{
  "name": "business",
  "tier": "T2 报告级",
  "color": ["#4E79A7", "#F28E2B", "#E15759", "#76B7B2", "#59A14F", "#EDC948", "#B07AA1", "#FF9DA7", "#9C755F", "#BAB0AC"],
  "backgroundColor": "transparent",
  "textStyle": { "fontFamily": "'Noto Sans SC', 'Source Han Sans SC', 'Microsoft YaHei', Arial, sans-serif" },
  "title": {
    "textStyle": { "fontSize": 16, "fontWeight": 600, "color": "#1A1A1A" },
    "subtextStyle": { "fontSize": 13, "color": "#666666" },
    "left": "left", "top": 0, "itemGap": 4
  },
  "legend": {
    "textStyle": { "fontSize": 13, "color": "#333333" },
    "itemGap": 16, "itemWidth": 16, "itemHeight": 9, "icon": "roundRect"
  },
  "tooltip": {
    "backgroundColor": "#FFFFFF", "borderColor": "#D9D9D9", "borderWidth": 1,
    "padding": [8, 12], "textStyle": { "fontSize": 13, "color": "#333333" },
    "extraCssText": "box-shadow: 0 2px 8px rgba(0,0,0,0.12);"
  },
  "categoryAxis": {
    "axisLine": { "lineStyle": { "color": "#D0D0D0" } },
    "axisTick": { "show": false },
    "axisLabel": { "color": "#4D4D4D", "fontSize": 12 },
    "splitLine": { "show": false }
  },
  "valueAxis": {
    "axisLine": { "show": false },
    "axisTick": { "show": false },
    "axisLabel": { "color": "#4D4D4D", "fontSize": 12 },
    "splitLine": { "show": true, "lineStyle": { "color": "#D9D9D9", "width": 0.6 } }
  },
  "timeAxis": {
    "axisLine": { "lineStyle": { "color": "#D0D0D0" } },
    "axisLabel": { "color": "#4D4D4D", "fontSize": 12 },
    "splitLine": { "show": false }
  },
  "logAxis": {
    "axisLine": { "show": false },
    "axisLabel": { "color": "#4D4D4D", "fontSize": 12 },
    "splitLine": { "show": true, "lineStyle": { "color": "#D9D9D9", "width": 0.6 } }
  }
}
