# showcase.mplstyle —— T3 展示级默认主题（配合 references/style/palettes/showcase.json 使用）
# 注意：mplstyle 文件中 "#" 会被解析为行内注释，颜色一律用 RGB 元组（0-1 浮点）书写，
# 与色板 JSON 中十六进制的对应关系已在各行注释中标明（注释在行首，安全）。
# 大字号、粗线条、高对比，远距离可读；适合 PPT 16:9 与海报

# ---- 画布 ----
figure.figsize: 8, 4.5
figure.dpi: 110
figure.facecolor: white
savefig.dpi: 200
savefig.bbox: tight
savefig.pad_inches: 0.05
savefig.facecolor: white

# ---- 字体：中文思源黑体(Noto Sans SC) + 西文/数字 Arial ----
font.family: sans-serif
font.sans-serif: Source Han Sans SC, Noto Sans SC, Microsoft YaHei, Arial, Helvetica, DejaVu Sans
mathtext.fontset: stix
axes.unicode_minus: False

# ---- 文字层级：比报告级再大一档，最后一排观众也要能读 ----
axes.titlesize: 15
axes.titleweight: bold
axes.labelsize: 12
xtick.labelsize: 11
ytick.labelsize: 11
legend.fontsize: 11

# ---- 坐标轴 ----
# 色板: #C0C0C0 / #4D4D4D / #D9D9D9
axes.linewidth: 1
axes.edgecolor: 0.753, 0.753, 0.753
axes.labelcolor: 0.2, 0.2, 0.2
# 色板 categorical: 0077BB EE7733 009988 EE3377 33BBEE CC3311 BBBBBB
axes.prop_cycle: cycler('color', [(0, 0.467, 0.733), (0.933, 0.467, 0.2), (0, 0.6, 0.533), (0.933, 0.2, 0.467), (0.2, 0.733, 0.933), (0.8, 0.2, 0.067), (0.733, 0.733, 0.733)])
axes.axisbelow: True
xtick.color: 0.302, 0.302, 0.302
ytick.color: 0.302, 0.302, 0.302
xtick.direction: out
ytick.direction: out

# ---- 网格：仅 y 向，更浅 ----
axes.grid: True
axes.grid.axis: y
grid.color: 0.851, 0.851, 0.851
grid.linewidth: 0.6
grid.linestyle: -
grid.alpha: 0.5

# ---- 去顶右刺 ----
axes.spines.top: False
axes.spines.right: False

# ---- 数据元素：粗线大点，强调冲击力 ----
lines.linewidth: 2.5
lines.markersize: 7
lines.markeredgewidth: 0
patch.linewidth: 0
errorbar.capsize: 3
hatch.linewidth: 0.5

# ---- 图例 ----
legend.frameon: False
legend.handlelength: 1.6
legend.borderaxespad: 0.4

# ---- 导出：矢量优先，文字保持可编辑 ----
pdf.fonttype: 42
ps.fonttype: 42
svg.fonttype: none
