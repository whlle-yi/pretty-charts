flowchart TD
    S(["开始：用户提交订单"]) --> V["参数校验"]
    V -->|"校验失败"| E["返回 400 错误"]
    V -->|"校验通过"| Q{"库存充足？"}
    Q -->|"否"| N["下单失败通知"]
    Q -->|"是"| P["扣减库存"]
    P --> Pmt["创建支付单"]
    Pmt --> Pay{"支付结果"}
    Pay -->|"成功"| OK(["订单完成"])
    Pay -->|"超时未付"| C["取消订单并回补库存"]
    C -.-> N
    classDef key fill:#0072B2,color:#FFFFFF,stroke:#0072B2
    class P,Pmt,OK key
